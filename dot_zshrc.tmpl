{{- if eq .chezmoi.hostname "m1-mbp" }}
# Only run fastfetch on m1-mbp
fastfetch
{{- end }}

# --------------------------------
#   Language variables

# English for messages/errors, Swedish for regional formats
export LANG="sv_SE.UTF-8"
export LC_COLLATE="sv_SE.UTF-8"
export LC_CTYPE="sv_SE.UTF-8"
export LC_MESSAGES="en_US.UTF-8"
export LC_MONETARY="sv_SE.UTF-8"
export LC_NUMERIC="sv_SE.UTF-8"
export LC_TIME="sv_SE.UTF-8"

# Unsetting these to avoid conflicts
unset LC_ALL
unset LC_CTYPE
unset LC_TERMINAL
unset LANGUAGE

# --------------------------------
#   Oh My Zsh

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time Oh My Zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="robbyrussell"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# You can set one of the optional three formats:
# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# or set a custom format using the strftime function format specifications,
# see 'man strftime' for details.
HIST_STAMPS="yyyy-mm-dd"

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
# Conditionally load macos aliases based on hostname
plugins=(1password aliases brew docker docker-compose git pyenv sudo tailscale zsh-syntax-highlighting {{ if eq .chezmoi.hostname "m1-mbp" }}macos ssh-agent{{ end }})

{{- if eq .chezmoi.hostname "m1-mbp" }}
# SSH-Agent plugin settings
zstyle :omz:plugins:ssh-agent identities id_ed25519
{{- end }}

# Source Oh My Zsh so that it runs when a new shell starts
source $ZSH/oh-my-zsh.sh

# --------------------------------
#   User configuration
# --------------------------------

# --------------------------------
#   SSH key loading

{{- if eq .chezmoi.hostname "m1-mbp" }}
# Load SSH key into macOS keychain agent on shell startup
ssh-add --apple-use-keychain ~/.ssh/id_ed25519 2>/dev/null

# Set GitHub PAT for MCP use
export GITHUB_MCP_PERSONAL_ACCESS_TOKEN="{{ onepasswordRead "op://Personal/GitHub/Personal Access Tokens/Docker MCP Server token" }}"
{{- end }}

# --------------------------------
#   Path edits

{{- if eq .chezmoi.hostname "m1-mbp" }}
# Add Pyenv to Path
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# Add Bun installed packages to Path
export PATH="$HOME/.bun/bin:$PATH"

# Antigravity editor
export PATH="/Users/cstalhem/.antigravity/antigravity/bin:$PATH"
{{- end }}

# --------------------------------
#   Editor settings

# Preferred editor
if [[ -n $SSH_CONNECTION ]]; then
  # Use nano for ssh sessions
  export EDITOR='nano'
else
  # Use VS Code for local sessions
  export EDITOR='code --wait'
fi

{{- if eq .chezmoi.hostname "m1-mbp" }}
# --------------------------------
#   Docker desktop

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/cstalhem/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions

{{- end}}

# --------------------------------
#   Executables

# Enable shell completion with 1Password
eval "$(op completion zsh)"; compdef _op op

# --------------------------------
#   Starship

# Initialise Starship
eval "$(starship init zsh)"
