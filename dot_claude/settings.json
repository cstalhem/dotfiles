{
  "cleanupPeriodDays": 30,
  "attribution": {
    "commit": "🤖 Generated with Claude Code\n\nCo-Authored-By: Claude <noreply@anthropic.com>"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(npm run test:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(rm:*)",
      "WebFetch"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/bin/bash /Users/cstalhem/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "obsidian@personal-marketplace": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true
  },
  "outputStyle": "Learning",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "api.github.com",
        "github.com"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "git"
    ]
  },
  "alwaysThinkingEnabled": true
}
