#!/bin/bash

#
# 00-header - MOTD Header with ASCII art hostname
# Part of custom MOTD dashboard
#

# ==============================================================================
# Source common functions
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"

# Configuration
NICKNAME="Home Server"

# Get system info
HOSTNAME_SHORT=$(hostname -s 2>/dev/null || hostname)
OS_INFO=$(source /etc/os-release 2>/dev/null; echo "$PRETTY_NAME")
OS_INFO="${OS_INFO:-Unknown OS}"
KERNEL_INFO=$(uname -sr)

# Print header box
echo ""
box_top_border "$HOSTNAME_SHORT" "$CYAN"
box_line ""
box_line "$NICKNAME" "${BOLD}${CYAN}"
box_line "${OS_INFO}  •  ${KERNEL_INFO}" "$DIM"
box_line ""
box_bottom_border
